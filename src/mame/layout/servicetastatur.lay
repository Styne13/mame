<?xml version="1.0"?>
<mamelayout version="2">

	<!-- Define black background element -->
	<element name="static_black">
		<rect>
			<color red="0" green="0" blue="0" />
		</rect>
	</element>

	<!-- Define screen element for LCD display -->
	<element name="screen_lcd">
		<rect>
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
	</element>

	<view name="LCD Display">
		<bounds left="0" right="100" top="0" bottom="20" />
		<element ref="static_black">
			<bounds left="0" right="100" top="0" bottom="20" />
		</element>

		<!-- HD44780 2x40 LCD display -->
		<screen tag="screen">
			<bounds left="5" right="95" top="2" bottom="18" />
		</screen>
	</view>

</mamelayout>
