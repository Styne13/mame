<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

	<element name="led_red" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.17" green="0.015" blue="0.02" /></disk>
	</element>

	<element name="green_led" defstate="0">
		<rect state="0">
			<color red="0" green="0.2" blue="0" />
		</rect>
		<rect state="1">
			<color red="0" green="0.8" blue="0" />
		</rect>
	</element>

<!-- define elements -->
	<element name="static_black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<group name="machine">
		<element ref="static_black">
			<bounds left="0" right="110" top="0" bottom="50" />
		</element>

<!-- Anzeigenplatine chains: digit<anzout><field> (0 = 150er, 3 = Serienspeicher, 5 = Muenzspeicher); the four fields run 2,0,3,1 from left to right -->
		<element name="digit00" ref="digit">
			<bounds x="20" y="1" width="8" height="8" />
		</element>
		<element name="digit01" ref="digit">
			<bounds x="40" y="1" width="8" height="8" />
		</element>
		<element name="digit02" ref="digit">
			<bounds x="10" y="1" width="8" height="8" />
		</element>
		<element name="digit03" ref="digit">
			<bounds x="30" y="1" width="8" height="8" />
		</element>

		<element name="digit30" ref="digit">
			<bounds x="20" y="10" width="8" height="8" />
		</element>
		<element name="digit31" ref="digit">
			<bounds x="40" y="10" width="8" height="8" />
		</element>
		<element name="digit32" ref="digit">
			<bounds x="10" y="10" width="8" height="8" />
		</element>
		<element name="digit33" ref="digit">
			<bounds x="30" y="10" width="8" height="8" />
		</element>

		<element name="digit50" ref="digit">
			<bounds x="20" y="19" width="8" height="8" />
		</element>
		<element name="digit51" ref="digit">
			<bounds x="40" y="19" width="8" height="8" />
		</element>
		<element name="digit52" ref="digit">
			<bounds x="10" y="19" width="8" height="8" />
		</element>
		<element name="digit53" ref="digit">
			<bounds x="30" y="19" width="8" height="8" />
		</element>

<!-- second Anzeigenplatine (ANZ2): digit<80+anzout*10+field> -->
		<element name="digit80" ref="digit">
			<bounds x="70" y="1" width="8" height="8" />
		</element>
		<element name="digit81" ref="digit">
			<bounds x="90" y="1" width="8" height="8" />
		</element>
		<element name="digit82" ref="digit">
			<bounds x="60" y="1" width="8" height="8" />
		</element>
		<element name="digit83" ref="digit">
			<bounds x="80" y="1" width="8" height="8" />
		</element>

		<element name="digit110" ref="digit">
			<bounds x="70" y="10" width="8" height="8" />
		</element>
		<element name="digit111" ref="digit">
			<bounds x="90" y="10" width="8" height="8" />
		</element>
		<element name="digit112" ref="digit">
			<bounds x="60" y="10" width="8" height="8" />
		</element>
		<element name="digit113" ref="digit">
			<bounds x="80" y="10" width="8" height="8" />
		</element>

		<element name="digit130" ref="digit">
			<bounds x="70" y="19" width="8" height="8" />
		</element>
		<element name="digit131" ref="digit">
			<bounds x="90" y="19" width="8" height="8" />
		</element>
		<element name="digit132" ref="digit">
			<bounds x="60" y="19" width="8" height="8" />
		</element>
		<element name="digit133" ref="digit">
			<bounds x="80" y="19" width="8" height="8" />
		</element>

		<!-- control unit-->
		<element name="led0" ref="led_red">
			<bounds left="40" right="45" top="30" bottom="35" />
		</element>
		<element name="led1" ref="led_red">
			<bounds left="50" right="55" top="30" bottom="35" />
		</element>

		<!-- debug-->
		<repeat count="12">
			<param name="s" start="0" increment="1" />
			<param name="x" start="0" increment="2" />
			<repeat count="8">
			<param name="z" start="0" increment="1" />
			<param name="y" start="30" increment="2" />
				<element name="lamp~z~~s~" ref="green_led">
					<bounds x="~x~" y="~y~" width="1" height="1" />
				</element>
			</repeat>
		</repeat>


	</group>

	<view name="Internal Layout + Service Keyboard">
		<bounds left="0" right="110" top="0" bottom="62" />
		<group ref="machine" />
		<element ref="static_black">
			<bounds left="0" right="110" top="50" bottom="62" />
		</element>
		<screen index="0">
			<bounds x="0" y="52" width="110" height="8" />
		</screen>
	</view>

	<view name="Internal Layout">
		<bounds left="0" right="110" top="0" bottom="50" />
		<group ref="machine" />
	</view>
</mamelayout>
